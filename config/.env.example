# =====================================================================
# 配置模板：复制为 config/.env 后填入本机真实值
#   copy config\.env.example config\.env
# config/.env 已被 .gitignore 排除，不会进入版本库。
# =====================================================================

APPLICATION_NAME=olist-ecommerce-analysis

# ------------------------- SSH 隧道 -------------------------
# 不需要 SSH 跳板时设为 false，并在 application.yml 中同步 ssh.enabled
SSH_ENABLED=true
SSH_HOST=your.ssh.host.or.ip
SSH_PORT=22
SSH_USER=your_ssh_user
# 私钥路径；推荐使用 ~/.ssh 下的密钥，不要放进项目目录
SSH_PRIVATE_KEY=C:/Users/your_name/.ssh/id_ed25519
SSH_PRIVATE_KEY_PASSWORD=""
# 建议填写服务器主机公钥指纹以防中间人攻击；留空则不校验
SSH_HOST_KEY=""

# SSH 隧道在远端服务器内部访问的 MySQL 地址
MYSQL_REMOTE_HOST=127.0.0.1
MYSQL_REMOTE_PORT=3306

# ------------------------- MySQL -------------------------
# 注意：库名需与 sql/navicat_mysql8_import.sql 中 CREATE DATABASE 的值一致
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE=olist
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=15
MYSQL_READ_TIMEOUT=600
