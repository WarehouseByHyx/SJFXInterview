APPLICATION_NAME=olist-ecommerce-analysis

# SSH 服务器
SSH_ENABLED=true
SSH_HOST=你的服务器地址
SSH_PORT=22 #端口号默认为22
SSH_USER=root
SSH_PRIVATE_KEY=你的私钥位置（如C:/****/***/）
SSH_PRIVATE_KEY_PASSWORD=""
SSH_HOST_KEY=""

# SSH 隧道在云服务器内部访问的 MySQL 地址
MYSQL_REMOTE_HOST=127.0.0.1
MYSQL_REMOTE_PORT=3306

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=你的数据库账号
MYSQL_PASSWORD="你的数据库密码"
MYSQL_DATABASE=olist_ecommerce
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=15
MYSQL_READ_TIMEOUT=600

